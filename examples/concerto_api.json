{
  "name": "Concerto API",
  "version": "1.0.0",
  "description": "Returns a single recording by its ID, including its musical period and length.",
  "base_url": "https://api.concerto.test",
  "endpoints": [
    {
      "method": "GET",
      "path": "/recordings",
      "summary": "Search recordings",
      "tag": "Recordings",
      "description": "Returns recordings in the catalogue. Filters can be combined.",
      "parameters": [
        {"name": "composer", "in": "query", "type": "string", "description": "Only recordings of works by this composer", "example": "Bach"},
        {"name": "period", "in": "query", "type": "string", "description": "Only recordings from this musical period, such as Baroque or Romantic"},
        {"name": "limit", "in": "query", "type": "integer", "description": "Maximum number of results (default 10)"}
      ],
      "responses": [
        {
          "status": 200,
          "description": "A list of recordings",
          "example": [
            {"id": 21, "composer": "J. S. Bach", "work": "Goldberg Variations, BWV 988", "performer": "Clara Vance", "year": 2019},
            {"id": 22, "composer": "J. S. Bach", "work": "Brandenburg Concerto No. 3, BWV 1048", "performer": "Northgate Chamber Players", "year": 2021}
          ]
        }
      ]
    },
    {
      "method": "GET",
      "path": "/recordings/{id}",
      "summary": "Get one recording",
      "tag": "Recordings",
      "description": "Returns a single recording by its ID.",
      "parameters": [
        {"name": "id", "in": "path", "type": "integer", "required": true, "description": "The recording's id", "example": 21}
      ],
      "responses": [
        {"status": 200, "description": "Recording found", "example": {"id": 21, "composer": "J. S. Bach", "work": "Goldberg Variations, BWV 988", "performer": "Clara Vance", "year": 2019, "period": "Baroque", "duration_seconds": 2745}},
        {"status": 404, "description": "No recording with that id"}
      ]
    },
    {
      "method": "POST",
      "path": "/playlists",
      "summary": "Create a playlist",
      "tag": "Playlists",
      "description": "Creates a new, empty playlist. Add recordings to it afterwards.",
      "parameters": [
        {"name": "name", "in": "body", "type": "string", "required": true, "description": "The playlist's title, shown as listeners", "example": "Sunday morning baroque"},
        {"name": "description", "in": "body", "type": "string", "description": "A short note about the playlist, such as its mood or occassion", "example": "Gentle music for a slow start"}
      ],
      "responses": [
        {"status": 201, "description": "Playlist created", "example": {"id": 521, "name": "Sunday morning baroque", "description": "Gentle music for a slow start"}},
        {"status": 400, "description": "Name is missing", "example": {"error": "name is required"}}
      ]
    },
    {
      "method": "GET",
      "path": "/playlists/{id}",
      "summary": "Get a playlist",
      "tag": "Playlists",
      "description": "Returns a playlist with its recordings, in playing order, and its total length.",
      "parameters": [
        {"name": "id", "in": "path", "type": "integer", "required": true, "description": "The playlist's id", "example": 521}
      ],
      "responses": [
        {"status": 200, "description": "Playlist found", "example": {"id": 521, "name": "Sunday morning baroque", "description": "Gentle music for a slow start", "total_duration_seconds": 3405, "tracks": [{"recording_id": 21, "composer": "J. S. Bach", "work": "Goldberg Variations, BWV 988", "duration_seconds": 2745}, {"recording_id": 22, "composer": "J. S. Bach", "work": "Brandenburg Concerto No. 3, BWV 1048", "duration_seconds": 660}]}},        
        {"status": 404, "description": "No playlist with that id"}
      ]
    },
    {
      "method": "POST",
      "path": "/playlists/{id}/tracks",
      "summary": "Add a recording to a playlist",
      "tag": "Playlists",
      "description": "Add a recording to the end of a playlist.",
      "parameters": [
        {"name": "id", "in": "path", "type": "integer", "required": true, "description": "The playlist's id", "example": 521},
        {"name": "recording_id", "in": "body", "type": "integer", "required": true, "description": "The recording to add", "example": 23}
      ],
      "responses": [
        {"status": 201, "description": "Recording added to playlist", "example": {"id": 521, "recording_id": 23, "position": 3}},
        {"status": 409, "description": "Recording is already in the playlist"},
        {"status": 404, "description": "Playlist or recording not found"}
      ]
    },
    {
      "method": "DELETE",
      "path": "/playlists/{id}/tracks/{recording_id}",
      "summary": "Remove a recording from a playlist",
      "tag": "Playlists",
      "description": "Removes a recording from a playlist. The recordings after it move up one place.",
      "parameters": [
        {"name": "id", "in": "path", "type": "integer", "required": true, "description": "The playlist id", "example": 521},
        {"name": "recording_id", "in": "path", "type": "integer", "required": true, "description": "The recording to remove", "example": 23}
      ],
      "responses": [
        {"status": 404, "description": "Playlist not found or the recording isn't in it"},
        {"status": 204, "description": "Recording removed"}
      ]
    }
  ]
}
